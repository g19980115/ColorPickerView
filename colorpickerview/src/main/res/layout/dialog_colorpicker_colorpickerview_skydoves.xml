<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="#D6E0EB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/colorPickerViewFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.skydoves.colorpickerview.ColorPickerView
                    android:id="@+id/colorPickerView"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="50dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    app:selector="@drawable/wheel" />

            </FrameLayout>

            <com.skydoves.colorpickerview.AlphaTileView
                android:id="@+id/alphaTileView"
                android:layout_width="35dp"
                android:layout_height="25dp"
                android:layout_gravity="start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:background="@android:color/white"
                android:orientation="horizontal"
                app:tileSize="20" />

            <TextView
                android:id="@+id/etPrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="55dp"
                android:layout_marginTop="20dp"
                android:text="#"
                android:textSize="18sp"
                android:visibility="invisible" />

            <EditText
                android:id="@+id/etColor"
                android:layout_width="120dp"
                android:layout_height="45dp"
                android:layout_marginStart="65dp"
                android:layout_marginTop="10dp"
                android:digits="0123456789ABCDEFabcdef"
                android:maxLength="8"
                android:textSize="18sp"
                android:visibility="invisible"
                tools:text="aabbcc" />

        </FrameLayout>


        <FrameLayout
            android:id="@+id/alphaSlideBarFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.skydoves.colorpickerview.sliders.AlphaSlideBar
                android:id="@+id/alphaSlideBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="10dp"
                app:radius_AlphaSlideBar="12dp"
                app:selector_AlphaSlideBar="@drawable/wheel" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_brightness_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:textColor="?android:textColorSecondary" />

        <FrameLayout
            android:id="@+id/brightnessSlideBarFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.skydoves.colorpickerview.sliders.BrightnessSlideBar
                android:id="@+id/brightnessSlideBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="10dp"
                app:radius_BrightnessSlider="12dp"
                app:selector_BrightnessSlider="@drawable/wheel" />
        </FrameLayout>

        <Space
            android:id="@+id/space_bottom"
            android:layout_width="match_parent"
            android:layout_height="10dp" />

    </LinearLayout>

</ScrollView>
